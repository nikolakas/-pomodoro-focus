rules_version = '2';

// Firestore security rules for the Pomodoro Focus app.
// Deploy via Firebase Console → Firestore Database → Rules → Publish,
// or `firebase deploy --only firestore:rules` if you set up the CLI.
service cloud.firestore {
  match /databases/{database}/documents {

    // Private per-user data (history, xp, settings). Owner only.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Private social data (your friend code). Owner only.
    match /social/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Mutual friendships: one doc per pair, listing both members' uids.
    // Either member may read/create/delete; a member may only create a doc
    // that includes their own uid (can't fabricate friendships for others).
    match /friendships/{pair} {
      // resource == null when the doc doesn't exist (existence check) — allow that read.
      allow read: if request.auth != null
                  && (resource == null || request.auth.uid in resource.data.users);
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.users;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.users
                    && request.resource.data.users.size() == 2;
      allow update: if false;
    }

    // Username → uid lookup. Any signed-in user may read/list (to search & resolve).
    // A username doc may only be created pointing at the creator's own uid
    // (prevents hijacking someone else's handle), and only its owner may delete
    // it (so a user can release a handle when changing username). No updates.
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Public leaderboard stats. Any signed-in user may read (so friends can see
    // each other). Each user may only write their own entry.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Friend requests: sender creates; both sender and recipient can read/delete.
    match /friendRequests/{reqId} {
      allow create: if request.auth != null
                    && request.resource.data.from == request.auth.uid;
      // resource == null when the doc doesn't exist (existence check) — allow that read.
      allow read: if request.auth != null
                  && (resource == null
                      || resource.data.from == request.auth.uid
                      || resource.data.to == request.auth.uid);
      allow delete: if request.auth != null
                    && (resource.data.from == request.auth.uid
                        || resource.data.to == request.auth.uid);
      allow update: if false;
    }

    // Direct messages between friends. pairId = sortedJoin('_') of both uids
    // (Firebase UIDs are alphanumeric — no underscores — so split is unambiguous).
    match /chat/{pairId} {
      allow read, write: if request.auth != null
        && (pairId.split('_')[0] == request.auth.uid
            || pairId.split('_')[1] == request.auth.uid);
    }
  }
}
