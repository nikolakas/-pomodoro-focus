rules_version = '2';

// Firestore security rules for the Pomodoro Focus app.
// Deploy via Firebase Console → Firestore Database → Rules → Publish,
// or `firebase deploy --only firestore:rules` if you set up the CLI.
service cloud.firestore {
  match /databases/{database}/documents {

    // Private per-user data (history, xp, settings). Owner only.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Private social data (your friend code + friends list). Owner only.
    match /social/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Friend-code → uid lookup. Any signed-in user may read (to resolve a code).
    // A code may only be created if it doesn't already exist, and must point at
    // the creator's own uid (prevents hijacking someone else's code).
    match /codes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Public leaderboard stats. Any signed-in user may read (so friends can see
    // each other). Each user may only write their own entry.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
